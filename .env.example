# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent identity (spoken in greeting; never speak extensions)
AGENT_DISPLAY_NAME=Alex

# Provider mode: livekit_inference (recommended) | openai_direct
PROVIDER_MODE=livekit_inference

# LiveKit Inference models (no Deepgram/Cartesia keys required)
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=en
LLM_MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=72
TTS_MODEL=cartesia/sonic-3
# Jacqueline — confident young American female (LiveKit suggested Cartesia voice)
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
TTS_LANGUAGE=en
TTS_EMOTION=calm

# Optional: only needed for PROVIDER_MODE=openai_direct
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
ANTHROPIC_API_KEY=

# Turn-taking / VAD
MIN_ENDPOINTING_DELAY=0.35
MAX_ENDPOINTING_DELAY=1.8
MIN_INTERRUPTION_DURATION=0.3
ALLOW_INTERRUPTIONS=true
PREEMPTIVE_GENERATION=true
TURN_DETECTOR=inference
TURN_DETECTOR_VERSION=v1

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Transfer behavior (see docs/OPEN_QUESTIONS.md)
TRANSFER_MODE=sip_uri
TRANSFER_SIP_DOMAIN=
TRANSFER_MAIN_NUMBER=
TRANSFER_FAILURE_MESSAGE=I'm sorry, I wasn't able to complete that transfer. Please try again later, or visit www.miamivalleycap.org.

# Business hours
TIMEZONE=America/New_York
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=16:30
LUNCH_START=12:00
LUNCH_END=13:00
AFTER_HOURS_MESSAGE=Thank you for calling Miami Valley Community Action Partnership. Our offices are currently closed. Hours are Monday through Friday, 8:00 a.m. to 4:30 p.m., closed for lunch from 12:00 to 1:00. Please visit www.miamivalleycap.org or call back during business hours. For additional resources, dial 211.

NO_EXTENSION_FALLBACK=main_line
NO_EXTENSION_MESSAGE=I'm sorry, I don't have a direct line for that person. I can transfer you to the main office, or you can leave a message — which would you prefer?

MVCAP_WEBSITE=https://www.miamivalleycap.org
HELPLINK_NUMBER=211
