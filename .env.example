# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent identity (spoken in greeting; never speak extensions)
AGENT_DISPLAY_NAME=Alex

# STT / LLM / TTS providers (livekit-agents plugins)
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=cartesia

# Provider API keys (only those you use)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=

# Optional model overrides
STT_MODEL=nova-3
LLM_MODEL=gpt-4o-mini
TTS_MODEL=
TTS_VOICE=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Transfer behavior (open question — see docs/OPEN_QUESTIONS.md)
# Modes: sip_uri | main_plus_ext | did
TRANSFER_MODE=sip_uri
TRANSFER_SIP_DOMAIN=
TRANSFER_MAIN_NUMBER=
TRANSFER_FAILURE_MESSAGE=I'm sorry, I wasn't able to complete that transfer. Please try again later, or visit www.miamivalleycap.org.

# Business hours (America/New_York). Closed 12:00–13:00 lunch.
TIMEZONE=America/New_York
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=16:30
LUNCH_START=12:00
LUNCH_END=13:00
AFTER_HOURS_MESSAGE=Thank you for calling Miami Valley Community Action Partnership. Our offices are currently closed. Hours are Monday through Friday, 8:00 a.m. to 4:30 p.m., closed for lunch from 12:00 to 1:00. Please visit www.miamivalleycap.org or call back during business hours. For additional resources, dial 211.

# Fallback when staff has no extension
NO_EXTENSION_FALLBACK=main_line
NO_EXTENSION_MESSAGE=I'm sorry, I don't have a direct line for that person. I can transfer you to the main office, or you can leave a message — which would you prefer?

# Website / HelpLink (referenced from rules; also used as ultimate fallback)
MVCAP_WEBSITE=https://www.miamivalleycap.org
HELPLINK_NUMBER=211
